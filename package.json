{
  "name": "techop-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@techop/core-api",
    "dev:crm": "npm run dev --workspace=@techop/crm-admin",
    "build": "npm run build --workspace=@techop/shared && npm run build --workspaces --if-present",
    "typecheck": "npm run build --workspace=@techop/shared && npm run typecheck --workspaces --if-present && tsc -p infra/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace=@techop/shared && npm run test --workspaces --if-present && npm run test:infra",
    "test:infra": "tsx --test infra/scripts/*.test.ts",
    "db:migrate": "tsx infra/scripts/migrate.ts",
    "db:migrate:status": "tsx infra/scripts/migrate.ts status"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
