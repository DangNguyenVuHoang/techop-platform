# Core API Foundation Environment Configuration
NODE_ENV=development
PORT=4001
API_PREFIX=/api/v1
LOG_LEVEL=info
SERVICE_NAME=techop-core-api

# PostgreSQL 17 Development Database (port 5434 avoids colliding with legacy 5432)
DATABASE_URL=postgresql://techop_app:techop_dev_password_change_me@127.0.0.1:5434/techop_platform_dev
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Comma-separated explicit origins (never use * in production)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Request JSON body size limit
JSON_BODY_LIMIT=1mb
